# Server
PORT=3100
HOST=0.0.0.0
NODE_ENV=development

# Auth — shared secret with Vercel frontend (Bearer token)
OPTIMA_AI_BACKEND_SECRET=

# OpenRouter (moved from Vercel serverless)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=Optima Seller AI

# Supabase — persistence only (archives, profiles, products)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — realtime state (typing, sessions, anti-duplicate)
REDIS_URL=
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
